<%- include('partials/header') %>

  <section class="section" style="padding-top: 8rem;">
    <div class="container">
      <div class="section-header">
        <h2>About <span class="highlight">NOVASPARK_ZW</span></h2>
        <p>Building the future of tech in Zimbabwe, one deployment at a time.</p>
      </div>

      <!-- Mission -->
      <div style="max-width: 800px; margin: 0 auto 4rem; text-align: center;">
        <p style="font-size: 1.2rem; color: var(--text-dim); line-height: 1.9;">
          NOVASPARK_ZW TECH was founded with a single mission: to make professional-grade tech services accessible to developers, businesses, and creators across Zimbabwe and beyond. We believe in empowering the next generation of African tech talent through affordable hosting, development services, and hands-on opportunities.
        </p>
      </div>

      <!-- Founder -->
      <div class="founder-section">
        <div>
          <div class="founder-avatar">NC</div>
        </div>
        <div class="founder-info">
          <h3>Ntandoyenkosi Chisaya</h3>
          <p class="title">Founder & CEO</p>
          <p>A passionate developer and tech entrepreneur from Zimbabwe, Ntandoyenkosi founded NOVASPARK_ZW TECH to bridge the gap between cutting-edge technology and local businesses. With expertise in bot development, web technologies, and server infrastructure, he leads the team in delivering solutions that work in the real world.</p>
          <p style="margin-top: 1rem; color: var(--text-dim);">"Technology should empower everyone, not just those who can afford Silicon Valley prices. That's why we exist."</p>
        </div>
      </div>

      <!-- Values -->
      <div style="margin-top: 5rem;">
        <div class="section-header">
          <h2>Our <span class="highlight">Values</span></h2>
        </div>
        <div class="services-grid">
          <div class="service-card">
            <div class="service-icon">💡</div>
            <h3>Innovation First</h3>
            <p>We stay ahead of the curve, adopting new technologies early and building solutions that are future-proof. No outdated stacks, no legacy baggage.</p>
          </div>
          <div class="service-card">
            <div class="service-icon">🤝</div>
            <h3>Community Driven</h3>
            <p>We actively recruit and mentor students, creating pathways into tech careers. Our internship program gives real-world experience, not busy work.</p>
          </div>
          <div class="service-card">
            <div class="service-icon">🎯</div>
            <h3>Results Oriented</h3>
            <p>We don't do fluff. Every service we offer is measured by outcomes - uptime, speed, conversions, growth. If it doesn't deliver, we fix it.</p>
          </div>
        </div>
      </div>

      <!-- Tech Stack -->
      <div style="margin-top: 5rem;">
        <div class="section-header">
          <h2>Our <span class="highlight">Tech Stack</span></h2>
          <p>We work with modern, battle-tested technologies</p>
        </div>
        <div class="stats-bar">
          <div class="stat-item">
            <div class="stat-number" style="font-size: 1.5rem;">Node.js</div>
            <div class="stat-label">Backend</div>
          </div>
          <div class="stat-item">
            <div class="stat-number" style="font-size: 1.5rem;">React</div>
            <div class="stat-label">Frontend</div>
          </div>
          <div class="stat-item">
            <div class="stat-number" style="font-size: 1.5rem;">Python</div>
            <div class="stat-label">Automation</div>
          </div>
          <div class="stat-item">
            <div class="stat-number" style="font-size: 1.5rem;">Docker</div>
            <div class="stat-label">Deployment</div>
          </div>
        </div>
      </div>
    </div>
  </section>

<%- include('partials/footer') %>
