  <script>
    document.getElementById('quickQuoteForm').addEventListener('submit', async function(e){
      e.preventDefault();
      const data = Object.fromEntries(new FormData(this));
      const msg = document.getElementById('qqMsg');
      const res = await fetch('/quote', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
      const json = await res.json();
      msg.textContent = json.message;
      msg.style.color = json.success ? 'var(--success)' : 'var(--warning)';
      msg.style.display = 'block';
      if(json.success){ this.reset(); setTimeout(()=>document.getElementById('quoteModal').style.display='none', 2500); }
    });
  </script>

