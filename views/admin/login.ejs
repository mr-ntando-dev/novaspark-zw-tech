<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login — NOVASPARK_ZW</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Rajdhani:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    body{background:#0a0e17;color:#e2e8f0;font-family:'Rajdhani',sans-serif;min-height:100vh;display:flex;align-items:center;justify-content:center;}
    .bg-grid{position:fixed;inset:0;background-image:linear-gradient(rgba(0,229,255,.03)1px,transparent 1px),linear-gradient(90deg,rgba(0,229,255,.03)1px,transparent 1px);background-size:60px 60px;z-index:0}
    .card{position:relative;z-index:1;background:#111827;border:1px solid rgba(0,229,255,.15);border-radius:16px;padding:3rem 2.5rem;width:100%;max-width:420px;box-shadow:0 20px 60px rgba(0,229,255,.1)}
    .logo{font-family:'Orbitron',monospace;font-size:1.4rem;font-weight:900;color:#00e5ff;text-align:center;margin-bottom:.3rem}
    .sub{text-align:center;color:#94a3b8;font-size:.95rem;margin-bottom:2rem}
    label{display:block;font-weight:600;color:#94a3b8;margin-bottom:.4rem;font-size:.9rem;text-transform:uppercase;letter-spacing:.05em}
    input[type=password]{width:100%;background:#1a2332;border:1px solid rgba(0,229,255,.2);border-radius:8px;padding:.75rem 1rem;color:#e2e8f0;font-family:inherit;font-size:1rem;outline:none;transition:.2s}
    input[type=password]:focus{border-color:#00e5ff;box-shadow:0 0 0 3px rgba(0,229,255,.1)}
    .btn{width:100%;margin-top:1.5rem;padding:.85rem;background:linear-gradient(135deg,#00e5ff,#7c4dff);border:none;border-radius:8px;color:#fff;font-family:'Orbitron',monospace;font-size:.9rem;font-weight:700;cursor:pointer;letter-spacing:.05em;transition:.2s}
    .btn:hover{opacity:.9;transform:translateY(-1px)}
    .error{background:rgba(255,23,68,.1);border:1px solid rgba(255,23,68,.3);border-radius:8px;padding:.75rem 1rem;color:#ff5252;margin-bottom:1.2rem;font-size:.95rem}
    .lock{font-size:3rem;text-align:center;margin-bottom:1.5rem}
  </style>
</head>
<body>
  <div class="bg-grid"></div>
  <div class="card">
    <div class="lock">🔐</div>
    <div class="logo">NOVASPARK_ZW</div>
    <div class="sub">Admin Access</div>
    <% if (error) { %>
    <div class="error"><%= error %></div>
    <% } %>
    <form method="POST" action="/admin/login">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" placeholder="Enter admin password" autofocus required>
      <button type="submit" class="btn">ENTER →</button>
    </form>
  </div>
</body>
</html>
