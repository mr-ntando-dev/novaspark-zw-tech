<%- include('partials/header') %>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-container">
      <div class="hero-content">
        <h1>Build. Host. <span class="highlight">Dominate.</span></h1>
        <p>NOVASPARK_ZW TECH delivers next-generation bot hosting, web development, domain services, and digital advertising solutions. From concept to deployment - we handle it all.</p>
        <div class="hero-buttons">
          <a href="/services" class="btn-primary">Our Services →</a>
          <a href="/pricing" class="btn-secondary">View Plans</a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-terminal">
          <div class="terminal-header">
            <div class="terminal-dot red"></div>
            <div class="terminal-dot yellow"></div>
            <div class="terminal-dot green"></div>
          </div>
          <div class="terminal-body">
            <div class="terminal-line"><span class="terminal-prompt">$</span> <span class="terminal-cmd">novaspark deploy --bot mybot</span></div>
            <div class="terminal-line"><span class="terminal-output">⠋ Initializing bot container...</span></div>
            <div class="terminal-line"><span class="terminal-output">⠋ Connecting to hosting panel...</span></div>
            <div class="terminal-line"><span class="terminal-output">⠋ Running health checks...</span></div>
            <div class="terminal-line"><span class="terminal-success">✓ Bot deployed successfully!</span></div>
            <div class="terminal-line"><span class="terminal-success">✓ Live at: panel.novaspark.co.zw</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES OVERVIEW -->
