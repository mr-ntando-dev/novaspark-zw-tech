    <div class="container">
      <div class="section-header">
        <h2>What We <span class="highlight">Deliver</span></h2>
        <p>End-to-end tech solutions built for performance, scale, and reliability.</p>
      </div>
      <div class="services-grid">
        <div class="service-card">
          <div class="service-icon">🤖</div>
          <h3>Bot Hosting Panel</h3>
          <p>24/7 uptime for your WhatsApp, Telegram, and Discord bots. Dedicated resources, auto-restart, and real-time monitoring dashboard.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">⚡</div>
          <h3>Bot Development</h3>
          <p>Custom bot development from scratch or upgrades to your existing bots. Multi-platform support with advanced command systems.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">🌐</div>
          <h3>Domain Registration</h3>
          <p>Register .co.zw, .com, .net, .org and 100+ TLDs. DNS management, WHOIS privacy, and auto-renewal included.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">🚀</div>
          <h3>Website Hosting</h3>
          <p>Lightning-fast SSD hosting with free SSL, daily backups, and 99.9% uptime guarantee. From simple sites to complex apps.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">📺</div>
          <h3>YouTube Monitoring</h3>
          <p>Track channels, monitor uploads, analytics dashboards, and automated alerts. Stay ahead of your competition.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">📢</div>
          <h3>Advertising & Promotion</h3>
          <p>Digital marketing campaigns, social media ads, SEO optimization, and brand growth strategies that deliver results.</p>
        </div>
      </div>

      <!-- STATS -->
      <div class="stats-bar">
        <div class="stat-item">
          <div class="stat-number">99.9%</div>
          <div class="stat-label">Uptime</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">500+</div>
          <div class="stat-label">Bots Hosted</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">24/7</div>
          <div class="stat-label">Support</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">50+</div>
          <div class="stat-label">Happy Clients</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Ready to <span class="highlight">Launch</span>?</h2>
        <p>Whether you need a bot hosted, a website built, or a domain registered - we've got you covered. Let's build something powerful.</p>
        <br>
        <a href="/contact" class="btn-primary">Contact Us →</a>
      </div>
    </div>
  </section>

